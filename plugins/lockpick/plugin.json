{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "lockpick",
  "version": "0.2.1",
  "description": "Scan your app, site, or AI skill before you ship.",
  "author": {
    "name": "Prompt Advisers",
    "url": "https://www.lockpick.app"
  },
  "homepage": "https://www.lockpick.app/docs/ai/other-mcp-apps",
  "license": "MIT",
  "keywords": [
    "security",
    "website-security",
    "dns",
    "pulse",
    "deep-scan",
    "repair",
    "lockpick"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Lockpick",
        "shortDescription": "Scan your app before you ship",
        "longDescription": "Scan your app, site, or AI skill before you ship. Check assets you own or are authorized to test. Read security findings, redacted evidence and coverage, then work through repairs and rechecks with your connected Lockpick workspace.",
        "developerName": "Prompt Advisers",
        "category": "Developer Tools",
        "capabilities": [
          "Read security findings",
          "Request authorized checks",
          "Guide repairs and rechecks"
        ],
        "websiteURL": "https://www.lockpick.app",
        "supportURL": "https://www.lockpick.app/en/claude",
        "privacyPolicyURL": "https://www.lockpick.app/en/privacy",
        "termsOfServiceURL": "https://www.lockpick.app/en/terms",
        "defaultPrompt": [
          "Show my Lockpick sites and allowance.",
          "Explain the top findings for my site.",
          "Help me repair a Lockpick finding."
        ],
        "brandColor": "#ed6c4f",
        "brandColorDark": "#ed6c4f",
        "logo": "./assets/graphite-lock.webp",
        "composerIcon": "./assets/graphite-lock.webp"
      },
      "onboardingSkill": "./skills/lockpick/SKILL.md"
    }
  }
}
